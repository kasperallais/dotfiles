general {
        colors = true
        interval = 5
}

order += "ipv6"
order += "wireless _first_"
order += "volume master"
order += "memory"
order += "tztime local"

wireless _first_ {
        format_up = "W: (%quality at %essid) %ip"
        format_down = "W: down"
}

volume master {
	format = "VOL: %volume"
	device = "default"
}

memory {
        format = "%used | %available"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%Y-%m-%d %H:%M:%S"
}

